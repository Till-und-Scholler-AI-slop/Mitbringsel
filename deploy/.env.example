# Template for <DEPLOY_DIR>/.env on the server, e.g.
# /opt/personal-projects/slop/mitbringsel/staging/.env (staging or prod).
# Values below are for staging; production differences are noted inline.
# The real .env holds secrets and is never committed.

# Read by Docker Compose itself: project name and which files to combine.
COMPOSE_PROJECT_NAME=mitbringsel-staging
# prod: mitbringsel-prod
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml
# prod: docker-compose.yml

# Images of the deployed commit; the deploy workflow updates this line.
IMAGE_TAG=change-me

APP_DOMAIN=mitbringsel-dev.tinowolter.com
# prod: mitbringsel.tinowolter.com
LOG_LEVEL=info

# The password ends up inside DATABASE_URL, so keep it URL-safe:
# openssl rand -hex 32
POSTGRES_USER=mitbringsel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mitbringsel

# Must match the Traefik setup on the VPS.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Staging only; prod does not use it.
AUTHELIA_MIDDLEWARE=authelia@docker
