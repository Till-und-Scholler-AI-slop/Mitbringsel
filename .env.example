# Copy to .env and adjust. The real .env is never committed.

# Required. development enables the dev login; staging and production set
# their value in the Compose files on the server.
APP_ENV=development

# Required. The values below match deploy/docker-compose.dev.yml.
DATABASE_URL=postgres://mitbringsel:mitbringsel@localhost:5432/mitbringsel?sslmode=disable

# Optional. Defaults: ":8080" (the Makefile uses 127.0.0.1:8080 for local dev) and "info".
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# Optional in development. Without the two GOOGLE_ values only the dev login
# works. Register http://localhost:5173/api/v1/auth/google/callback as an
# authorized redirect URI of the client in the Google Cloud Console.
# PUBLIC_BASE_URL is where the browser reaches the app; the default is the
# Vite dev server.
#PUBLIC_BASE_URL=http://localhost:5173
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
