# Copy to .env.local (never committed) to log in automatically during
# development. Only used by `npm run dev`; production builds ignore it.
#
# The backend must run with APP_ENV=development. For a second user at the
# same time, open a private window with ?devUser=<email>: cookies are shared
# by all normal windows of a browser profile.
VITE_DEV_USER_EMAIL=dev@example.com
VITE_DEV_USER_NAME=Dev
