# Copy to .env.local (never committed) to log in automatically during
# development. Only used by `npm run dev`; production builds ignore it.
#
# The backend must run with APP_ENV=development. For a second user at the
# same time, open a private window with ?devUser=<email>, e.g.
# http://localhost:5173/?devUser=ben@example.com: cookies are shared by all
# normal windows of a browser profile.
# The defaults below are a user from `make seed`; the other seed users are
# ben@example.com and chloe@example.com.
VITE_DEV_USER_EMAIL=anna@example.com
VITE_DEV_USER_NAME=Anna Schäfer
